CompileFlags:
  Add:
    - -Wno-pragma-pack
    - -Wno-unknown-pragmas
    - -Wno-unused-command-line-argument
    - -Wno-microsoft-include
    - -Wno-macro-redefined
    - -fms-extensions
    - -fms-compatibility
    - -ID:/PJ/KMDF Driver/Shared
    - -ID:/PJ/KMDF Driver/Driver
    - -ID:/PJ/KMDF Driver/NetProbe/include
    - -ID:/PJ/KMDF Driver/NetProbeLoader/include

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - unused-includes
    - -Wunused-includes


---
If:
  PathMatch: (Driver/.*|.*/Driver/.*)
CompileFlags:
  Add:
    - -D_AMD64_
    - -DAMD64
    - -D_WIN64
    - -D_KERNEL_MODE
    - -D_WIN32_WINNT=0x0A00
    - -DWINVER=0x0A00
    - -DWINNT=1
    - -DNTDDI_VERSION=0x0A000010
    - -DKMDF_VERSION_MAJOR=1
    - -DKMDF_VERSION_MINOR=15

---
If:
  PathMatch: (Client/.*|.*/Client/.*)
CompileFlags:
  Add:
    - -DWIN32_LEAN_AND_MEAN
    - -D_CONSOLE
    - -D_UNICODE
    - -DUNICODE
    - -D_WIN64
    - -D_AMD64_
    - -std=c++20

---
If:
  PathMatch: (NetProbeLoader/.*|.*/NetProbeLoader/.*)
CompileFlags:
  Add:
    - -ID:/PJ/KMDF Driver/NetProbeLoader/include
    - -DWIN32_LEAN_AND_MEAN
    - -D_WIN64
    - -D_AMD64_
    - -DAMD64
    - -D_WINDOWS
    - -D_USRDLL
    - -D_CRT_SECURE_NO_WARNINGS
    - -DNETPROBE_LOADER_TRACE=1

---
If:
  PathMatch: (NetProbe/.*|.*/NetProbe/.*)
CompileFlags:
  Add:
    - -ID:/PJ/KMDF Driver/NetProbe/include
    - -DWIN32_LEAN_AND_MEAN
    - -D_WIN64
    - -D_AMD64_
    - -DAMD64
    - -D_WINDOWS
    - -D_USRDLL
    - -D_CRT_SECURE_NO_WARNINGS

---
If:
  PathMatch: (HostListener/.*|.*/HostListener/.*)
CompileFlags:
  Add:
    - -DWIN32_LEAN_AND_MEAN
    - -D_CONSOLE
    - -D_UNICODE
    - -DUNICODE
    - -D_WIN64
    - -D_AMD64_
    - -D_CRT_SECURE_NO_WARNINGS

---
If:
  PathMatch: .*\.cpp$
CompileFlags:
  Add:
    - -std=c++20

---
If:
  PathMatch: .*Bypass\.c$
CompileFlags:
  Add:
    - -xc++
    - -std=c++20

